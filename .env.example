# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Database
# For development (SQLite) leave DATABASE_URL unset, or set it explicitly:
# DATABASE_URL=sqlite:///instance/app.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql://username:password@localhost:5432/coaching_marketplace

# Session
SESSION_HOURS=12
SESSION_COOKIE_SECURE=False

# Uploads
UPLOAD_FOLDER=app/static/uploads

# OTP
OTP_EXPIRY_MINUTES=10

# Defaults seeded into SystemSetting table on first run
# (afterwards, these are managed from the Admin Panel, not from this file)
DEFAULT_SEARCH_RADIUS_KM=5
DEFAULT_COMMISSION_PERCENT=10

# Rate limiting storage (use redis:// in production for multi-worker deployments)
RATELIMIT_STORAGE_URI=memory://

# Logging
LOG_DIR=logs

# --- Seed script (initial Super Admin account) ---
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD=ChangeMe123!

# ============================================================
# Google OAuth
# ============================================================
# Obtain these from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
